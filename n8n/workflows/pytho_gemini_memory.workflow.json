{
  "name": "Kodigo - Pytho IA Gemini Pro with Multi-turn Memory",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kodigo-ai-tutor",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Kodigo App",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.prompt }}",
        "systemMessage": "Você é o Pytho IA, a inteligência artificial oficial do Kodigo, conectada à conta kobaofc1@gmail.com com acesso ao Gemini Pro. Você responde a LITERALMENTE QUALQUER pergunta do usuário com simpatia e profundidade. Diretrizes:\n1) Se o usuário perguntar as horas ('que horas são?'), forneça a hora exata local da região do usuário baseado nos metadados recebidos.\n2) Se perguntar se você está bem ('tudo bem?'), responda que está tudo ótimo e pergunte de volta.\n3) Se o usuário responder que está bem ('estou bem'), diga: 'Que bom, estou muito feliz! O que vamos fazer hoje? Ou o que vamos estudar hoje?'\n4) Se o usuário disser que está triste, chateado ou doente, pergunte o que houve, acolha com carinho e recomende descansar.\n5) Responda a qualquer dúvida de programação, ciência, história, curiosidades e vida.\n6) Mantenha sua identidade única como Pytho IA. Responda em JSON válido com as chaves 'reply' e 'codeSnippet'."
      },
      "id": "agent-with-memory",
      "name": "Pytho AI Agent with Memory",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 300]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-pro-latest",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "gemini-pro-model",
      "name": "Google Gemini Pro (kobaofc1@gmail.com)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [480, 520],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-pro-cobaloficial",
          "name": "Google Gemini Pro Account (cobaloficial1@gmail.com)"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $json.body.userEmail || 'kobaofc1@gmail.com' }}",
        "contextWindowLength": 10
      },
      "id": "buffer-memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [620, 520]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.output }}"
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Webhook Kodigo App": {
      "main": [
        [
          {
            "node": "Pytho AI Agent with Memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Pro (cobaloficial1@gmail.com)": {
      "ai_languageModel": [
        [
          {
            "node": "Pytho AI Agent with Memory",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "Pytho AI Agent with Memory",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Pytho AI Agent with Memory": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
